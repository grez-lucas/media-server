# Copy to .env and adjust for this host. .env is gitignored - it is the only
# file that should differ between machines.

# Where the media library lives ON THE HOST. Every service mounts this at /data.
# Moving the library to an external drive or NAS means changing this line only.
MEDIA_ROOT=/srv/media

# The user/group the containers run as. Must own MEDIA_ROOT and ./config.
# Find yours with: id -u && id -g
PUID=1000
PGID=1000

# Find yours with: timedatectl show -p Timezone --value
TZ=America/Santiago

# Host ports. Defaults apply if unset; override only if this host already uses
# one of them, or to run a second instance alongside the first.
#JELLYFIN_PORT=8096
#RADARR_PORT=7878
#SONARR_PORT=8989
