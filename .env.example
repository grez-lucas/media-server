# Copy to .env and adjust for this host. .env is gitignored - it is the only
# file that should differ between machines.

# Where the media library lives ON THE HOST. Every service mounts this at /data.
# Moving the library to an external drive or NAS means changing this line only.
MEDIA_ROOT=/srv/media

# The user/group the containers run as. Must own MEDIA_ROOT and ./config.
# Find yours with: id -u && id -g
PUID=1000
PGID=1000

# Find yours with: timedatectl show -p Timezone --value
TZ=America/Santiago

# Host ports. Defaults apply if unset; override only if this host already uses
# one of them, or to run a second instance alongside the first.
#JELLYFIN_PORT=8096
#RADARR_PORT=7878
#SONARR_PORT=8989

# --- Secrets, for scripts/seed.sh -------------------------------------------
#
# These are INJECTED, never discovered. The seed knows every credential before
# the first container starts, so it never has to scrape a generated secret out
# of the gitignored config/ tree.
#
# Radarr and Sonarr accept their API key from the environment: measured on
# Radarr 6.3.0 and Sonarr 4.0.19, the key answers HTTP 200, a wrong key answers
# HTTP 401, and config.xml is written with no <ApiKey> element at all.
#
# Generate each of these with:  openssl rand -hex 16
RADARR_API_KEY=
SONARR_API_KEY=

# Jellyfin accepts no API call until its startup wizard has run, and that step
# requires creating an admin WITH a password - so on a BLANK host the seed
# cannot avoid holding one. Choose a real password; it is the account you sign
# in to Jellyfin with. Generate one with:  openssl rand -base64 24
JELLYFIN_ADMIN_USER=admin
JELLYFIN_ADMIN_PASSWORD=

# On a host whose wizard has ALREADY run, the seed only needs to read and
# compare - so an API key (Jellyfin Dashboard -> API Keys) is enough, and you
# need not hand the seed your password. If this is set it is used in preference
# to the username and password above.
#JELLYFIN_API_KEY=
